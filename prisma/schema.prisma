// Define el modelo de datos principal de Kotta para Prisma.
//
// Contiene las entidades, relaciones, enums y restricciones que sostienen la
// operación multi-coto: organizaciones, usuarios, sesiones, tickets, órdenes,
// pagos, activos, accesos, amenidades y códigos de verificación.
//
// Se relaciona con `src/lib/prisma.ts`, las migraciones en `prisma/migrations`,
// las rutas API bajo `src/app/api/*` y las páginas que consultan datos del
// condominio según el rol del usuario.
//
// Existe para que la base de datos comparta un contrato explícito con el código
// de aplicación y para aislar la lógica de Kotta por organización.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  ADMIN
  VECINO
  PROVEEDOR
  GUARDIA
}

enum TicketStatus {
  NUEVO
  EN_REVISION
  ASIGNADO
  EN_PROCESO
  RESUELTO
  CERRADO
}

enum TicketCategory {
  PLOMERIA
  ELECTRICIDAD
  HERRERIA
  JARDINERIA
  LIMPIEZA
  SEGURIDAD
  INFRAESTRUCTURA
  OTRO
}

enum WorkOrderStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  VENCIDO
}

enum AssetStatus {
  OK
  REVISION
  URGENTE
  INACTIVO
}

enum AssetCategory {
  BOMBA
  PORTON
  ILUMINACION
  AREA_COMUN
  SISTEMA_ELECTRICO
  CISTERNA
  OTRO
}

enum VisitorType {
  PROVEEDOR
  VISITA
  DELIVERY
  RESIDENTE
  OTRO
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}
enum AmenityStatus {
  ACTIVA
  INACTIVA
  MANTENIMIENTO
}

enum TipoCuentaConectada {
  CONDOMINIO
  PROVEEDOR
}

enum TipoCargo {
  MASIVO
  GRUPO
  INDIVIDUAL
}

enum EstadoPago {
  PENDIENTE
  PROCESANDO
  PAGADO
  FALLIDO
  EN_DISPUTA
  REEMBOLSADO
}

enum TipoOperacionPago {
  CARGO
  TRANSFERENCIA
}

// ─── Organization ────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  tickets    Ticket[]
  workOrders WorkOrder[]
  assets     Asset[]
  payments   Payment[]
  accessLogs AccessLog[]
  amenities  Amenity[]
  cuentaConectada CuentaConectada?
  cargos Cargo[]
  pagos  Pago[]

  @@map("organizations")
}

// ─── User ────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  name        String
  phone       String?
  role        Role
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id])

  houseNumber String?

  ticketsReported    Ticket[]    @relation("ReportedBy")
  workOrdersAssigned WorkOrder[] @relation("AssignedTo")
  payments           Payment[]
  accessLogsGuard    AccessLog[] @relation("GuardLog")
  reservations       AmenityReservation[]
  sessions           Session[]
  cuentaConectada CuentaConectada?
  cargosCreados       Cargo[]
  cargosDestinatario  CargoDestinatario[]
  pagosComoVecino     Pago[] @relation("PagosComoVecino")
  pagosComoProveedor  Pago[] @relation("PagosComoProveedor")
  notifications Notification[]

  @@index([orgId, role])
  @@map("users")
}

// ─── Ticket ──────────────────────────────────────────────────

model Ticket {
  id          String         @id @default(cuid())
  folio       String
  title       String
  description String
  status      TicketStatus   @default(NUEVO)
  category    TicketCategory @default(OTRO)
  photoUrl    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])

  reportedById String
  reportedBy   User   @relation("ReportedBy", fields: [reportedById], references: [id])

  workOrder WorkOrder?

  @@unique([orgId, folio])
  @@index([orgId, status, createdAt])
  @@index([reportedById, status, createdAt]) //new
  @@map("tickets")
}

// ─── WorkOrder ───────────────────────────────────────────────

model WorkOrder {
  id             String          @id @default(cuid())
  status         WorkOrderStatus @default(PENDIENTE)
  description    String?
  cost           Decimal?        @db.Decimal(10, 2)
  costNote String? // New
  beforePhotoUrl String?
  afterPhotoUrl  String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  closedAt       DateTime?

  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])

  ticketId   String    @unique
  ticket     Ticket    @relation(fields: [ticketId], references: [id])

  providerId String
  provider   User      @relation("AssignedTo", fields: [providerId], references: [id])

  accessLog  AccessLog?
  pagos      Pago[]

  @@index([orgId, createdAt])
  @@map("work_orders")
}

// ─── Asset ───────────────────────────────────────────────────

model Asset {
  id              String        @id @default(cuid())
  name            String
  category        AssetCategory @default(OTRO)
  status          AssetStatus   @default(OK)
  location        String?
  description     String?
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@map("assets")
}

// ─── Payment ─────────────────────────────────────────────────

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDIENTE)
  month     Int
  year      Int
  paidAt    DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  orgId  String
  org    Organization @relation(fields: [orgId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([orgId, userId, month, year])
  @@index([orgId, year, month])
  @@index([orgId, status])
  @@index([userId, year, month]) // new
  @@map("payments")
}

// ─── AccessLog ───────────────────────────────────────────────

model AccessLog {
  id          String      @id @default(cuid())
  visitorName String
  visitorType VisitorType @default(VISITA)
  entryTime   DateTime    @default(now())
  exitTime    DateTime?
  notes       String?
  createdAt   DateTime    @default(now())

  orgId   String
  org     Organization @relation(fields: [orgId], references: [id])

  guardId String
  guard   User   @relation("GuardLog", fields: [guardId], references: [id])

  workOrderId String?   @unique
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@map("access_logs")
}

// ─── Amenity ─────────────────────────────────────────────────

model Amenity {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?

  capacity        Int?
  durationMinutes Int    @default(60)

  startTime String @default("08:00")
  endTime   String @default("22:00")
  weekDays  Int[]  @default([0, 1, 2, 3, 4, 5, 6])

  requiresApproval Boolean  @default(false)
  extraCost        Decimal? @db.Decimal(10, 2)

  rules  String?
  status AmenityStatus @default(ACTIVA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  reservations AmenityReservation[]

  @@index([orgId, status])
  @@map("amenities")
}

// ─── AmenityReservation ──────────────────────────────────────

model AmenityReservation {
  id        String            @id @default(cuid())
  date      DateTime
  startTime String
  endTime   String
  status    ReservationStatus @default(PENDIENTE)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, date]) // new
  @@index([amenityId, date, status]) // new
  @@map("amenity_reservations")
}

// ─── Session ─────────────────────────────────────────────────
// Sesiones activas de usuarios autenticados

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@map("sessions")
}

// ─── VerificationCode ────────────────────────────────────────
// Códigos 2FA para registro, login e invitaciones

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      CodeType
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("verification_codes")
}

enum CodeType {
  REGISTRO
  LOGIN
  INVITACION
}


// ─── Flujo de Stripe ────────────────────────────────────────
model CuentaConectada {
  id                String              @id @default(cuid())
  tipo              TipoCuentaConectada
  stripeAccountId   String              @unique
  chargesEnabled    Boolean             @default(false)
  payoutsEnabled    Boolean             @default(false)
  detailsSubmitted  Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  orgId       String?       @unique
  org         Organization? @relation(fields: [orgId], references: [id])

  proveedorId String? @unique
  proveedor   User?   @relation(fields: [proveedorId], references: [id])

  @@map("cuentas_conectadas")
}

model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  tipo          String
  procesadoEn   DateTime @default(now())

  @@map("webhook_events")
}

model Notification {
  id        String   @id @default(cuid())
  tipo      String
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  cargoId String?
  cargo   Cargo?  @relation(fields: [cargoId], references: [id])

  @@index([userId, leida])
  @@map("notifications")
}

// ─── Módulo de pagos (Fase 2) ──────────────────────────────────

model Cargo {
  id            String              @id @default(cuid())
  concepto      String
  monto         Decimal
  fechaLimite   DateTime
  tipo          TipoCargo
  createdAt     DateTime            @default(now())

  orgId         String
  org           Organization        @relation(fields: [orgId], references: [id])

  creadoPorId   String
  creadoPor     User                @relation(fields: [creadoPorId], references: [id])

  destinatarios CargoDestinatario[]
  pagos         Pago[]
  notificaciones Notification[]

  @@map("cargos")
}

model CargoDestinatario {
  id          String @id @default(cuid())
  cargoId     String
  cargo       Cargo  @relation(fields: [cargoId], references: [id])

  viviendaId  String
  vivienda    User   @relation(fields: [viviendaId], references: [id])

  @@unique([cargoId, viviendaId])
  @@map("cargo_destinatarios")
}

model Pago {
  id                     String            @id @default(cuid())
  monto                  Decimal
  moneda                 String            @default("MXN")
  estado                 EstadoPago
  tipoOperacion          TipoOperacionPago
  stripePaymentIntentId  String?           @unique
  stripeTransferId       String?           @unique
  referencia             String?
  comprobanteUrl         String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])

  cargoId     String?
  cargo       Cargo?  @relation(fields: [cargoId], references: [id])

  vecinoId    String?
  vecino      User?   @relation("PagosComoVecino", fields: [vecinoId], references: [id])

  proveedorId String?
  proveedor   User?   @relation("PagosComoProveedor", fields: [proveedorId], references: [id])

  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])

  // CARGO conserva workOrderId en NULL, por lo que este unique permite un solo
  // pago por orden de trabajo sin bloquear los cobros a vecinos.
  @@unique([workOrderId])
  // Fase 3 conserva vecinoId en NULL para TRANSFERENCIA, por lo que este unique
  // protege los CARGO sin bloquear los pagos a proveedores actuales.
  @@unique([cargoId, vecinoId])
  @@map("pagos")
}
