// Define el modelo de datos principal de Kotta para Prisma.
//
// Contiene las entidades, relaciones, enums y restricciones que sostienen la
// operación multi-coto: organizaciones, usuarios, sesiones, tickets, órdenes,
// pagos, activos, accesos, amenidades y códigos de verificación.
//
// Se relaciona con `src/lib/prisma.ts`, las migraciones en `prisma/migrations`,
// las rutas API bajo `src/app/api/*` y las páginas que consultan datos del
// condominio según el rol del usuario.
//
// Existe para que la base de datos comparta un contrato explícito con el código
// de aplicación y para aislar la lógica de Kotta por organización.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  KOTTA_STAFF
  ADMIN
  VECINO
  PROVEEDOR
  GUARDIA
}

enum TicketStatus {
  NUEVO
  EN_REVISION
  ASIGNADO
  EN_PROCESO
  RESUELTO
  CERRADO
}

enum TicketCategory {
  PLOMERIA
  ELECTRICIDAD
  HERRERIA
  JARDINERIA
  LIMPIEZA
  SEGURIDAD
  INFRAESTRUCTURA
  OTRO
}

enum WorkOrderStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  VENCIDO
}

enum AssetStatus {
  OK
  REVISION
  URGENTE
  INACTIVO
}

enum AssetCategory {
  BOMBA
  PORTON
  ILUMINACION
  AREA_COMUN
  SISTEMA_ELECTRICO
  CISTERNA
  OTRO
}

enum VisitorType {
  PROVEEDOR
  VISITA
  DELIVERY
  RESIDENTE
  OTRO
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

enum AmenityStatus {
  ACTIVA
  INACTIVA
  MANTENIMIENTO
}

enum TipoCuentaConectada {
  CONDOMINIO
  PROVEEDOR
}

enum TipoCargo {
  MASIVO
  GRUPO
  INDIVIDUAL
}

enum EstadoPago {
  PENDIENTE
  PROCESANDO
  PAGADO
  FALLIDO
  EN_DISPUTA
  DISPUTA_PERDIDA
  REEMBOLSADO
}

enum TipoOperacionPago {
  CARGO
  TRANSFERENCIA
}

enum TipoDestino {
  CONDOMINIO
  PROVEEDOR
}

enum KottaSubscriptionStatus {
  PENDING_ACTIVATION
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum KottaBillingMode {
  MONTHLY
  ANNUAL
}

enum KottaSubscriptionEventType {
  SUBSCRIPTION_CREATED
  COMMERCIAL_CONFIGURED
  PRICE_UPDATED
  ACTIVATED
  MARKED_PAST_DUE
  PAYMENT_RECORDED
  SUSPENDED
  REACTIVATED
  RENEWED
  CANCELED
}

enum NotificationOrigin {
  MANUAL
  SYSTEM
}

enum NotificationEmailStatus {
  DISABLED
  PENDING
  SENT
  FAILED
}

// ─── Organization ────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  tickets            Ticket[]
  workOrders         WorkOrder[]
  assets             Asset[]
  payments           Payment[]
  accessLogs         AccessLog[]
  amenities          Amenity[]
  cuentaConectada    CuentaConectada?
  cargos             Cargo[]
  pagos              Pago[]
  distribucionesPago DistribucionPago[]
  kottaSubscription  KottaSubscription?
  notifications      Notification[]

  @@map("organizations")
}

// ─── User ────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id])

  houseNumber String?

  ticketsReported           Ticket[]                   @relation("ReportedBy")
  workOrdersAssigned        WorkOrder[]                @relation("AssignedTo")
  payments                  Payment[]
  accessLogsGuard           AccessLog[]                @relation("GuardLog")
  reservations              AmenityReservation[]
  sessions                  Session[]
  cuentaConectada           CuentaConectada?
  cargosCreados             Cargo[]
  cargosDestinatario        CargoDestinatario[]
  pagosComoVecino           Pago[]                     @relation("PagosComoVecino")
  pagosComoProveedor        Pago[]                     @relation("PagosComoProveedor")
  notifications             Notification[]             @relation("NotificationRecipient")
  notificationsSent         Notification[]             @relation("NotificationActor")
  kottaSubscriptionPayments KottaSubscriptionPayment[] @relation("KottaPaymentRecordedBy")
  kottaSubscriptionEvents   KottaSubscriptionEvent[]   @relation("KottaEventActor")

  @@index([orgId, role])
  @@map("users")
}

model KottaSubscription {
  id                     String                     @id @default(cuid())
  organizationId         String                     @unique
  organization           Organization               @relation(fields: [organizationId], references: [id])
  status                 KottaSubscriptionStatus    @default(PENDING_ACTIVATION)
  housingUnits           Int?
  billingMode            KottaBillingMode?
  isEnterprise           Boolean                    @default(false)
  baseMonthlyPrice       Decimal?                   @db.Decimal(12, 2)
  discountRate           Decimal?                   @db.Decimal(5, 4)
  contractedMonthlyPrice Decimal?                   @db.Decimal(12, 2)
  vatRate                Decimal?                   @db.Decimal(5, 4)
  pricingPolicyVersion   String                     @default("2026-01")
  contractSignedAt       DateTime?
  serviceStartedAt       DateTime?
  renewalAt              DateTime?
  nextInvoiceAt          DateTime?
  nextPaymentDueAt       DateTime?
  lastPaymentAt          DateTime?
  suspendedAt            DateTime?
  canceledAt             DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  payments               KottaSubscriptionPayment[]
  events                 KottaSubscriptionEvent[]

  @@index([status])
  @@index([billingMode])
  @@index([nextPaymentDueAt])
  @@index([renewalAt])
  @@map("kotta_subscriptions")
}

model KottaSubscriptionPayment {
  id             String            @id @default(cuid())
  subscriptionId String
  subscription   KottaSubscription @relation(fields: [subscriptionId], references: [id])
  period         String
  subtotal       Decimal           @db.Decimal(12, 2)
  vatAmount      Decimal           @db.Decimal(12, 2)
  lateFee        Decimal           @default(0) @db.Decimal(12, 2)
  totalExpected  Decimal           @db.Decimal(12, 2)
  amountReceived Decimal           @db.Decimal(12, 2)
  paidAt         DateTime
  bankReference  String?
  notes          String?
  recordedById   String
  recordedBy     User              @relation("KottaPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt      DateTime          @default(now())

  @@unique([subscriptionId, period])
  @@index([paidAt])
  @@map("kotta_subscription_payments")
}

model KottaSubscriptionEvent {
  id             String                     @id @default(cuid())
  subscriptionId String
  subscription   KottaSubscription          @relation(fields: [subscriptionId], references: [id])
  type           KottaSubscriptionEventType
  actorId        String?
  actor          User?                      @relation("KottaEventActor", fields: [actorId], references: [id])
  previousStatus KottaSubscriptionStatus?
  newStatus      KottaSubscriptionStatus?
  reason         String?
  metadata       Json?
  createdAt      DateTime                   @default(now())

  @@index([subscriptionId, createdAt])
  @@index([type, createdAt])
  @@map("kotta_subscription_events")
}

// ─── Ticket ──────────────────────────────────────────────────

model Ticket {
  id          String         @id @default(cuid())
  folio       String
  title       String
  description String
  status      TicketStatus   @default(NUEVO)
  category    TicketCategory @default(OTRO)
  photoUrl    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  reportedById String
  reportedBy   User   @relation("ReportedBy", fields: [reportedById], references: [id])

  workOrder WorkOrder?

  @@unique([orgId, folio])
  @@index([orgId, status, createdAt])
  @@index([reportedById, status, createdAt]) //new
  @@map("tickets")
}

// ─── WorkOrder ───────────────────────────────────────────────

model WorkOrder {
  id             String          @id @default(cuid())
  status         WorkOrderStatus @default(PENDIENTE)
  description    String?
  cost           Decimal?        @db.Decimal(10, 2)
  costNote       String? // New
  beforePhotoUrl String?
  afterPhotoUrl  String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  closedAt       DateTime?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  ticketId String @unique
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  providerId String
  provider   User   @relation("AssignedTo", fields: [providerId], references: [id])

  accessLog          AccessLog?
  pagos              Pago[]
  distribucionesPago DistribucionPago[]

  @@index([orgId, createdAt])
  @@map("work_orders")
}

// ─── Asset ───────────────────────────────────────────────────

model Asset {
  id              String        @id @default(cuid())
  name            String
  category        AssetCategory @default(OTRO)
  status          AssetStatus   @default(OK)
  location        String?
  description     String?
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@map("assets")
}

// ─── Payment ─────────────────────────────────────────────────

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDIENTE)
  month     Int
  year      Int
  paidAt    DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([orgId, userId, month, year])
  @@index([orgId, year, month])
  @@index([orgId, status])
  @@index([userId, year, month]) // new
  @@map("payments")
}

// ─── AccessLog ───────────────────────────────────────────────

model AccessLog {
  id          String      @id @default(cuid())
  visitorName String
  visitorType VisitorType @default(VISITA)
  entryTime   DateTime    @default(now())
  exitTime    DateTime?
  notes       String?
  createdAt   DateTime    @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  guardId String
  guard   User   @relation("GuardLog", fields: [guardId], references: [id])

  workOrderId String?    @unique
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@map("access_logs")
}

// ─── Amenity ─────────────────────────────────────────────────

model Amenity {
  id          String  @id @default(cuid())
  name        String
  description String?
  imageUrl    String?

  capacity        Int?
  durationMinutes Int  @default(60)

  startTime String @default("08:00")
  endTime   String @default("22:00")
  weekDays  Int[]  @default([0, 1, 2, 3, 4, 5, 6])

  requiresApproval Boolean  @default(false)
  extraCost        Decimal? @db.Decimal(10, 2)

  rules  String?
  status AmenityStatus @default(ACTIVA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  reservations AmenityReservation[]

  @@index([orgId, status])
  @@map("amenities")
}

// ─── AmenityReservation ──────────────────────────────────────

model AmenityReservation {
  id        String            @id @default(cuid())
  date      DateTime
  startTime String
  endTime   String
  status    ReservationStatus @default(PENDIENTE)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, date]) // new
  @@index([amenityId, date, status]) // new
  @@map("amenity_reservations")
}

// ─── Session ─────────────────────────────────────────────────
// Sesiones activas de usuarios autenticados

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("sessions")
}

// ─── VerificationCode ────────────────────────────────────────
// Códigos 2FA para registro, login e invitaciones

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      CodeType
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("verification_codes")
}

enum CodeType {
  REGISTRO
  LOGIN
  INVITACION
}

// ─── Flujo de Stripe ────────────────────────────────────────
model CuentaConectada {
  id               String              @id @default(cuid())
  tipo             TipoCuentaConectada
  stripeAccountId  String              @unique
  chargesEnabled   Boolean             @default(false)
  payoutsEnabled   Boolean             @default(false)
  detailsSubmitted Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  orgId String?       @unique
  org   Organization? @relation(fields: [orgId], references: [id])

  proveedorId String? @unique
  proveedor   User?   @relation(fields: [proveedorId], references: [id])

  @@map("cuentas_conectadas")
}

model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  tipo          String
  procesadoEn   DateTime @default(now())

  @@map("webhook_events")
}

model Notification {
  id               String                  @id @default(cuid())
  tipo             String
  origin           NotificationOrigin      @default(SYSTEM)
  titulo           String
  mensaje          String
  href             String?
  entityType       String?
  entityId         String?
  leida            Boolean                 @default(false)
  readAt           DateTime?
  emailStatus      NotificationEmailStatus @default(DISABLED)
  emailAttemptedAt DateTime?
  emailProviderId  String?
  deduplicationKey String?
  createdAt        DateTime                @default(now())

  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  cargoId String?
  cargo   Cargo?  @relation(fields: [cargoId], references: [id])

  @@unique([userId, deduplicationKey])
  @@index([userId, leida, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([emailStatus, createdAt])
  @@map("notifications")
}

// ─── Módulo de pagos (Fase 2) ──────────────────────────────────

model Cargo {
  id          String    @id @default(cuid())
  concepto    String
  monto       Decimal
  fechaLimite DateTime
  tipo        TipoCargo
  createdAt   DateTime  @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  creadoPorId String
  creadoPor   User   @relation(fields: [creadoPorId], references: [id])

  destinatarios  CargoDestinatario[]
  pagos          Pago[]
  notificaciones Notification[]

  @@map("cargos")
}

model CargoDestinatario {
  id      String @id @default(cuid())
  cargoId String
  cargo   Cargo  @relation(fields: [cargoId], references: [id])

  viviendaId String
  vivienda   User   @relation(fields: [viviendaId], references: [id])

  @@unique([cargoId, viviendaId])
  @@map("cargo_destinatarios")
}

model Pago {
  id                     String            @id @default(cuid())
  monto                  Decimal
  montoOriginal          Decimal           @default(0)
  montoConRecargo        Decimal?
  metodoPagoSeleccionado String?
  stripeFeeAmount        Decimal?
  montoNeto              Decimal?
  moneda                 String            @default("MXN")
  estado                 EstadoPago
  tipoOperacion          TipoOperacionPago
  enPlataforma           Boolean           @default(true)
  stripePaymentIntentId  String?           @unique
  stripeTransferId       String?           @unique
  referencia             String?
  comprobanteUrl         String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  cargoId String?
  cargo   Cargo?  @relation(fields: [cargoId], references: [id])

  vecinoId String?
  vecino   User?   @relation("PagosComoVecino", fields: [vecinoId], references: [id])

  proveedorId String?
  proveedor   User?   @relation("PagosComoProveedor", fields: [proveedorId], references: [id])

  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])

  distribucionesOrigen DistribucionPago[] @relation("PagoOrigenDistribuciones")
  disputaStripe        DisputaStripe?

  // CARGO conserva workOrderId en NULL, por lo que este unique permite un solo
  // pago por orden de trabajo sin bloquear los cobros a vecinos.
  @@unique([workOrderId])
  // Fase 3 conserva vecinoId en NULL para TRANSFERENCIA, por lo que este unique
  // protege los CARGO sin bloquear los pagos a proveedores actuales.
  @@unique([cargoId, vecinoId])
  @@map("pagos")
}

/**
 * Registro de auditoría de disputas de Stripe asociado a un único Pago.
 */
model DisputaStripe {
  id              String    @id @default(cuid())
  pagoId          String    @unique
  pago            Pago      @relation(fields: [pagoId], references: [id])
  stripeDisputeId String    @unique
  monto           Decimal
  moneda          String
  motivo          String
  estadoStripe    String
  fechaLimite     DateTime?
  creadaEn        DateTime
  cerradaEn       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([estadoStripe, fechaLimite])
  @@map("disputas_stripe")
}

model DistribucionPago {
  id                  String      @id @default(cuid())
  pagoOrigenId        String?
  pagoOrigen          Pago?       @relation("PagoOrigenDistribuciones", fields: [pagoOrigenId], references: [id])
  destino             TipoDestino
  cuentaConectadaId   String
  monto               Decimal
  montoOriginal       Decimal     @default(0)
  comisionEstimada    Decimal?
  estado              EstadoPago
  stripeTransferId    String?     @unique
  sourceTransactionId String?
  origenManual        Boolean     @default(false)
  notaManual          String?
  workOrderId         String?
  workOrder           WorkOrder?  @relation(fields: [workOrderId], references: [id])
  referencia          String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  @@unique([workOrderId])
  @@index([orgId])
  @@map("distribuciones_pago")
}

model ConciliacionPayoutMensual {
  id                   String   @id @default(cuid())
  periodo              String   @unique
  totalEstimadoCobrado Decimal
  totalRealFacturado   Decimal?
  diferencia           Decimal?
  estado               String   @default("PENDIENTE")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("conciliaciones_payout_mensual")
}
